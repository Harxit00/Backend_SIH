# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (STEP 2: MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-risk-quantification
# Agar MongoDB Atlas use kar rahe hain toh actual connection string daalein

# AI Risk Engine Configuration (STEP 4: AI Team)
# Assuming AI team ne Python (Flask/FastAPI) par Risk Engine banaya hai
AI_ENGINE_API_URL=http://localhost:8000/api/calculate-risk

# Optional: Ollama LLM Configuration (STEP 5: Bonus)
# Agar Ollama locally chal raha hai
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_NAME=llama3.2

# CORS Origin (Frontend se connect karne ke liye)
FRONTEND_URL=http://localhost:5173